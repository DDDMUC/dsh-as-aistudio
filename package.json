{
  "name": "dsh-as-aistudio",
  "version": "0.1.1",
  "description": "Google-AI-Studio-style turn controls for DeepSeek Harness, in one install: edit a prompt and re-run it, re-run a reply in place, delete a turn from the model context, and render sent prompts as Markdown. Each of the four components is an independent plugin that also works alone, and any subset of them coexists; this package composes them, enables the rows that mount them, and reports which ones are live in Settings -> Plugins -> AI Studio.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "docs/INTEROP.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "aistudio",
    "ai-studio",
    "edit",
    "rerun",
    "delete",
    "markdown",
    "turn"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDDMUC/dsh-as-aistudio.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "optionalDependencies": {
    "dsh-delete-turn": "^0.1.7",
    "dsh-edit-turn": "^0.2.14",
    "dsh-markdown-bubble": "^0.1.1",
    "dsh-rerun-turn": "^0.1.22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "engines": {
      "dsh": ">=0.1.6-alpha.2"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.6-alpha.2": "compatible",
        "0.2.0-rc.1": "compatible"
      }
    }
  }
}